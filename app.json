{
  "expo": {
    "name": "Cart & Crown",
    "slug": "cart-and-crown",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.elroybenjamins.cartcrown",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-foreground.png",
        "backgroundColor": "#0B182A",
        "monochromeImage": "./assets/branding/adaptive-monochrome.png"
      }
    },
    "ios": {
      "bundleIdentifier": "com.cartandcrown.mobile",
      "supportsTablet": false
    },
    "plugins": [
      "./plugins/withFrescoEarlyInit"
    ],
    "icon": "./assets/branding/icon.png"
  }
}
